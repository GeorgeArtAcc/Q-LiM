# Q-LiM - Copyright (c) 2026 Georgi Stanimirov Ivanov. SPDX-License-Identifier: GPL-3.0-or-later (see LICENSE)
# ===== Q-LiM for 32-bit Windows (XP, Vista, 7, 8, 10, 11 - 32 and 64-bit) - cross-compiled on Linux =====
#   sh packaging/build-deps.sh win32     (once: the libraries, static, into /opt/lnx/win32/prefix)
#   make -f Makefile.win32               -> build-win32/qlim.exe (one file: everything is linked in)
#   make -f Makefile.win32 zip           -> build-win32/Q-LiM-<version>-win32.zip (portable)
# Toolchain: llvm-mingw i686, msvcrt runtime. -march=pentiumpro: no SSE/SSE2 needed (Pentium II/III, Athlon ...).
# src/win/xpshim.c lets the C++ runtime run on XP (Vista+ kernel32 functions -> replacements when missing).

WIN       ?= /opt/win32
LLVM      ?= $(WIN)/llvm-mingw-20241217-msvcrt-ubuntu-20.04-x86_64
PKGROOT   ?= /opt/lnx
P         := $(PKGROOT)/win32/prefix
CC        := $(LLVM)/bin/i686-w64-mingw32-clang
CXX       := $(LLVM)/bin/i686-w64-mingw32-clang++
WINDRES   := $(LLVM)/bin/i686-w64-mingw32-windres
RTMIDI    := $(PKGROOT)/src/rtmidi

OUT       := build-win32
OBJ       := $(OUT)/obj

DEFS      := -D_WIN32_WINNT=0x0501 -DWINVER=0x0501 -DHAVE_RUBBERBAND -DUNICODE -D_UNICODE -DQLIM_XP_SHIM
ARCH      := -march=pentiumpro
INC       := -Isrc -Isrc/win/include -I$(P)/include -I$(P)/include/SDL2 -I$(RTMIDI) \
             -Ithird_party/rubberband -Ithird_party/lv2 -Ithird_party/lilv -Ithird_party/clap/include -Ithird_party/vst3
COMMON    := -O2 -g $(ARCH) -include src/win/compat.h $(DEFS) $(INC) -Wall -Wno-unused-parameter -Wno-unused-function
CFLAGS    := -std=c11 $(COMMON)
CXXFLAGS  := -std=c++17 $(COMMON)

# (os/subsystem version 5.1: otherwise lld writes 6.0 and XP says "not a valid Win32 application")
LIBS      := -static -L$(P)/lib -lmingw32 -lSDL2main -lSDL2_ttf -lharfbuzz -lfreetype -lSDL2 -lsndfile -lFLAC -lvorbisenc -lvorbis -lopus -logg \
             -lmpg123 -lmp3lame -lportaudio -lwinmm -lole32 -loleaut32 -luuid -lsetupapi -lksuser -limm32 -lversion \
             -lcomdlg32 -lshell32 -lpsapi -luser32 -lgdi32 -ladvapi32 -lws2_32 -lshlwapi -lpthread -mwindows \
             -Wl,--major-os-version,5 -Wl,--minor-os-version,1 -Wl,--major-subsystem-version,5 -Wl,--minor-subsystem-version,1

SRC_C     := src/main.c src/audio.c src/session.c src/wav.c src/ui.c src/filebrowser.c src/project.c src/settings.c \
             src/theme.c src/stream.c src/dsp_meter.c src/devwatch.c src/stream_sndfile.c src/stream_resample.c \
             src/mixer.c src/midiq.c src/midimap.c src/smf.c src/peaks.c src/sdlgfx.c src/logo_font.c src/dropfiles.c src/undo.c src/ui_dialogs.c src/ui_settings.c src/ui_midi.c src/ui_wave.c src/ui_device.c src/ui_channels.c src/ui_topbar.c src/export.c src/separate.c src/schedule.c src/surround.c src/mcfile.c src/outx.c src/perf.c src/bpm.c src/stretch.c \
             src/applog.c src/edit.c src/plughost.c src/plugbridge.c src/fxchain.c src/plugins.c src/host_vst2.c src/host_clap.c \
             src/win/compat.c src/win/stubs_win.c src/win/diskinfo_win.c src/win/plugwin_win.c src/win/xpshim.c
SRC_CXX   := src/midi.cpp src/host_vst3.cpp src/pitchshift.cpp
OBJS      := $(patsubst %.c,$(OBJ)/%.o,$(SRC_C)) $(patsubst %.cpp,$(OBJ)/%.o,$(SRC_CXX)) \
             $(OBJ)/rtmidi.o $(OBJ)/rubberband.o $(OBJ)/qlim_res.o
# 1.4.13: pitch shifting - Signalsmith Stretch (third_party/signalsmith, header-only, MIT)
$(OBJ)/src/pitchshift.o: CXXFLAGS += -O3 -ffast-math -Ithird_party/signalsmith -Ithird_party/signalsmith/linear/include

all: $(OUT)/qlim.exe

$(OUT)/qlim.exe: $(OBJS)
	@mkdir -p $(OUT)/assets
	$(CXX) -o $@ $(OBJS) $(LIBS)
	cp assets/DejaVuSans.ttf $(OUT)/assets/
	cp LICENSE $(OUT)/LICENSE.txt

$(OBJ)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJ)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(OBJ)/rtmidi.o: $(RTMIDI)/RtMidi.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++17 -O2 $(ARCH) -D_WIN32_WINNT=0x0501 -D__WINDOWS_MM__ -I$(RTMIDI) -c $< -o $@

$(OBJ)/rubberband.o: third_party/rubberband/single/RubberBandSingle.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++14 -O3 $(ARCH) -ffast-math -w -c $< -o $@

$(OBJ)/qlim_res.o: src/win/qlim.rc assets/icons/qlim.ico
	@mkdir -p $(dir $@)
	$(WINDRES) -I. src/win/qlim.rc -O coff -o $@

# portable zip: qlim.exe + font + licences (debug info stripped)
VERSION   := $(shell sed -n 's/^\#define QLIM_VERSION *"\(.*\)"/\1/p' src/version.h)
ZIPDIR    := $(OUT)/Q-LiM-$(VERSION)-win32
zip: $(OUT)/qlim.exe
	rm -rf $(ZIPDIR) $(ZIPDIR).zip && mkdir -p $(ZIPDIR)/assets
	cp $(OUT)/qlim.exe $(ZIPDIR)/ && $(LLVM)/bin/llvm-strip --strip-debug $(ZIPDIR)/qlim.exe
	cp assets/DejaVuSans.ttf $(ZIPDIR)/assets/
	cp LICENSE $(ZIPDIR)/LICENSE.txt; cp installer/NOTICE.txt $(ZIPDIR)/NOTICE.txt
	cd $(OUT) && zip -qr9 Q-LiM-$(VERSION)-win32.zip Q-LiM-$(VERSION)-win32

# ONE installer for all Windows (XP..11): this 32-bit build + the 64-bit one (make -f Makefile.win dist first).
# Inno Setup 5.6.1 (the last whose installers run on XP), installed under Wine in $(IS5PREFIX).
WINE      ?= $(WIN)/wine-10.0-amd64-wow64/bin/wine
IS5PREFIX ?= $(WIN)/wpxp
installer: zip
	test -f build-win/dist/qlim.exe || $(MAKE) -f Makefile.win dist
	cd installer && LANG=C.UTF-8 WINEPREFIX=$(IS5PREFIX) WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" \
	    $(WINE) 'C:\IS5\ISCC.exe' /Q /DAppVersion=$(VERSION) qlim-all.iss
	@echo ">>> $(OUT)/Q-LiM-Setup-$(VERSION).exe"

clean:
	rm -rf $(OUT)

-include $(OBJS:.o=.d)
.PHONY: all clean zip installer
