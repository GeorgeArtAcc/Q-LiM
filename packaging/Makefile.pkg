# Q-LiM - Copyright (c) 2026 Georgi Stanimirov Ivanov. SPDX-License-Identifier: GPL-3.0-or-later (see LICENSE)
# ===== Linux packages: a self-contained qlim (libraries built in, see build-deps.sh) =====
#   make -f packaging/Makefile.pkg T=gnu      -> build-pkg/gnu/qlim   (+ .deb and .rpm with "make ... packages")
#   make -f packaging/Makefile.pkg T=musl     -> build-pkg/musl/qlim  (+ .apk)
#   make -f packaging/Makefile.pkg T=gnu32    -> build-pkg/gnu32/qlim  (32-bit, i686 without SSE2; .deb i386 + .rpm)
#   make -f packaging/Makefile.pkg T=musl32   -> build-pkg/musl32/qlim (32-bit Alpine x86; .apk)
# Only the system's libc, ALSA (libasound.so.2) and X11 (libX11.so.6) are needed at run time - the package
# manager installs them automatically if they are missing (they are on every desktop anyway).

T        ?= gnu
PKGROOT  ?= /opt/lnx
P        := $(PKGROOT)/$(T)/prefix
OUT      := build-pkg/$(T)
OBJD     := $(OUT)/obj
VERSION  := $(shell sed -n 's/^\#define QLIM_VERSION *"\(.*\)"/\1/p' src/version.h)

ARCHF    :=
ifneq ($(filter musl musl32,$(T)),)
ifeq ($(T),musl32)
TC       := $(PKGROOT)/i686-unknown-linux-musl/bin/i686-unknown-linux-musl
ARCHF    := -march=i686 -mtune=generic -fno-stack-protector
EXTRA_C  := packaging/ssp_local.c
else
TC       := $(PKGROOT)/x86_64-unknown-linux-musl/bin/x86_64-unknown-linux-musl
endif
CC       := $(TC)-gcc
CXX      := $(TC)-g++
STRIP    := $(TC)-strip
XINC     := -I$(PKGROOT)/$(T)/xroot/usr/include
X11LIB   := $(PKGROOT)/$(T)/xroot/usr/lib/libX11.so
EXTRA_C  ?=
else ifeq ($(T),gnu32)
# clang + a glibc 2.42 i686 link sysroot (built from source) + compiler-rt + static libc++, through the wrapper
# packaging/gnu32-cc.sh; packaging/glibc32_compat.h pins the old glibc symbol versions (baseline 2.17), so the same
# qlim runs on old and new 32-bit distributions. Steps: HANDOFF.md / packaging/build-rt-gnu32.sh.
CC       := $(PKGROOT)/gnu32/bin/cc
CXX      := $(PKGROOT)/gnu32/bin/c++
STRIP    := llvm-strip-18
ARCHF    :=
XINC     := -I$(PKGROOT)/gnu32/xroot/usr/include -include packaging/gnu32inc/ext/atomicity.h -DSMTG_USE_STDATOMIC_H=0
X11LIB   := $(PKGROOT)/gnu32/xroot/usr/lib/libX11.so
EXTRA_C  := packaging/glibc_compat.c
else
CC       := gcc
CXX      := g++
STRIP    := strip
XINC     :=
X11LIB   := -lX11
EXTRA_C  := packaging/glibc_compat.c
endif

INC      := -Isrc -I$(P)/include -I$(P)/include/SDL2 -Ithird_party/rubberband \
            -Ithird_party/lv2 -Ithird_party/lilv -Ithird_party/clap/include -Ithird_party/vst3 $(XINC)
CFLAGS   := -std=c11 -O2 -g $(ARCHF) -Wall -Wno-unused-parameter -DHAVE_RUBBERBAND $(INC)
CXXFLAGS := -std=c++17 -O2 -g $(ARCHF) -Wall -Wno-unused-parameter $(INC)
PW_INC   := -isystem third_party/pipewire/pipewire-0.3 -isystem third_party/pipewire/spa-0.2
JACK_INC := -isystem $(PKGROOT)/src/jackinc          # 1.4.0: the JACK API headers (src/jack_shim.c)

SRC_C    := src/main.c src/audio.c src/session.c src/wav.c src/ui.c src/filebrowser.c src/project.c src/settings.c \
            src/theme.c src/stream.c src/diskinfo.c src/dsp_meter.c src/devwatch.c src/stream_sndfile.c \
            src/stream_resample.c src/mixer.c src/midiq.c src/midimap.c src/smf.c src/peaks.c src/sdlgfx.c src/logo_font.c src/dropfiles.c src/undo.c src/ui_dialogs.c src/ui_settings.c src/ui_midi.c src/ui_wave.c src/ui_device.c src/ui_channels.c src/ui_topbar.c src/export.c src/separate.c src/schedule.c src/surround.c src/mcfile.c src/outx.c src/perf.c \
            src/bpm.c src/stretch.c src/applog.c src/audio_pw.c src/edit.c src/plugins.c src/plughost.c src/plugbridge.c src/host_vst2.c \
            src/host_clap.c src/host_lv2.c src/fxchain.c src/plugwin.c src/jack_shim.c $(EXTRA_C)
SRC_CXX  := src/midi.cpp src/host_vst3.cpp src/pitchshift.cpp
OBJS     := $(patsubst %.c,$(OBJD)/%.o,$(SRC_C)) $(patsubst %.cpp,$(OBJD)/%.o,$(SRC_CXX)) \
            $(OBJD)/rtmidi.o $(OBJD)/rubberband.o
# 1.4.13: pitch shifting - Signalsmith Stretch (third_party/signalsmith, header-only, MIT)
$(OBJD)/src/pitchshift.o: CXXFLAGS += -O3 -ffast-math -U__FAST_MATH__ -Ithird_party/signalsmith -Ithird_party/signalsmith/linear/include

# static: SDL2, SDL2_ttf (+FreeType, HarfBuzz), libsndfile (+codecs), PortAudio; dynamic: libasound, libX11, libc
STATIC   := $(P)/lib/libSDL2_ttf.a $(P)/lib/libharfbuzz.a $(P)/lib/libfreetype.a $(P)/lib/libSDL2.a $(P)/lib/libportaudio.a \
            $(P)/lib/libsndfile.a $(P)/lib/libFLAC.a $(P)/lib/libvorbisenc.a $(P)/lib/libvorbis.a $(P)/lib/libopus.a \
            $(P)/lib/libogg.a $(P)/lib/libmpg123.a $(P)/lib/libmp3lame.a
ifeq ($(T),gnu32)
# libpthread/libdl/librt stay NEEDED: on glibc < 2.34 the (old-version) thread functions live there
LIBS     := $(STATIC) -L$(P)/lib -lasound $(X11LIB) -lm -Wl,--no-as-needed -l:libpthread.so.0 -l:libdl.so.2 -l:librt.so.1 -Wl,--as-needed
else
LIBS     := $(STATIC) -L$(P)/lib -lasound $(X11LIB) -lm -lpthread -ldl -lrt -static-libstdc++
endif

all: $(OUT)/qlim

# 1.4.14: vocal separation runs in its own program (only the 64-bit glibc build: ONNX Runtime exists only there).
# It loads ONNX Runtime by dlopen - nothing of it is linked into qlim or into the package.
SEP_HELPER := $(if $(filter gnu,$(T)),$(OUT)/qlim-separate)
$(OUT)/qlim-separate: src/sep/qlim_separate.c
	$(CC) -std=c11 -O2 $(ARCHF) -Wall -Ithird_party/onnxruntime/include -I$(P)/include $< $(EXTRA_C) -o $@ \
	    $(P)/lib/libsndfile.a $(P)/lib/libFLAC.a $(P)/lib/libvorbisenc.a $(P)/lib/libvorbis.a $(P)/lib/libopus.a \
	    $(P)/lib/libogg.a $(P)/lib/libmpg123.a $(P)/lib/libmp3lame.a -lm -lpthread -ldl

# 2.0.0: NOTHING of qlim is exported (no -rdynamic, bundled libraries hidden). Exported symbols were taken by plugins
# instead of their own (libstdc++, FLAC, ogg, harfbuzz, the glibc fixes below ...) - a plugin could hang or crash.
$(OUT)/qlim: $(OBJS)
	$(CXX) -Wl,--as-needed -Wl,--exclude-libs,ALL $(OBJS) -o $@ $(LIBS)
	@if nm -D --defined-only $@ | grep ' [TtWi] ' | grep -qvE ' _(init|fini)$$'; then echo '!!! qlim exports functions - plugins would take them'; nm -D --defined-only $@ | grep ' [TtWi] ' | head; exit 1; fi
	@echo ">>> $@ built"

$(OBJD)/packaging/glibc_compat.o: CFLAGS += -fvisibility=hidden   # never visible to plugins (see the file)

$(OBJD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(if $(findstring audio_pw,$<),$(PW_INC)) $(if $(findstring jack_shim,$<),$(JACK_INC)) -MMD -MP -c $< -o $@

$(OBJD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(PKGROOT)/src/rtmidi -MMD -MP -c $< -o $@

$(OBJD)/rtmidi.o: $(PKGROOT)/src/rtmidi/RtMidi.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++17 -O2 $(ARCHF) -D__LINUX_ALSA__ -I$(P)/include -I$(PKGROOT)/src/rtmidi -c $< -o $@

$(OBJD)/rubberband.o: third_party/rubberband/single/RubberBandSingle.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++14 -O3 $(ARCHF) -ffast-math -U__FAST_MATH__ -w -c $< -o $@

# ---- package tree: /opt/qlim + menu entry, icons, file type ----
ROOT     := $(OUT)/root
tree: $(OUT)/qlim $(SEP_HELPER)
	rm -rf $(ROOT)
	mkdir -p $(ROOT)/opt/qlim/assets $(ROOT)/usr/bin $(ROOT)/usr/share/applications $(ROOT)/usr/share/mime/packages \
	         $(ROOT)/usr/share/doc/qlim
	cp $(OUT)/qlim $(ROOT)/opt/qlim/qlim
	$(STRIP) --strip-debug $(ROOT)/opt/qlim/qlim
	$(if $(SEP_HELPER),cp $(SEP_HELPER) $(ROOT)/opt/qlim/ && $(STRIP) $(ROOT)/opt/qlim/qlim-separate)
	cp assets/DejaVuSans.ttf $(ROOT)/opt/qlim/assets/
	install -m 755 packaging/qlim-old-gpu-fix.sh $(ROOT)/opt/qlim/qlim-old-gpu-fix.sh
	cp LICENSE $(ROOT)/usr/share/doc/qlim/copyright
	ln -s /opt/qlim/qlim $(ROOT)/usr/bin/qlim
	cp packaging/qlim.desktop $(ROOT)/usr/share/applications/qlim.desktop
	cp packaging/qlim-project.xml $(ROOT)/usr/share/mime/packages/qlim-project.xml
	for s in 16 24 32 48 64 128 256 512; do \
	    mkdir -p $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/apps $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/mimetypes; \
	    cp assets/icons/qlim-$$s.png $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/apps/qlim.png; \
	    cp assets/icons/qlim-project-$$s.png $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/mimetypes/application-x-qlim-project.png; \
	done
	mkdir -p $(ROOT)/usr/share/icons/hicolor/scalable/apps && cp assets/icons/qlim.svg $(ROOT)/usr/share/icons/hicolor/scalable/apps/qlim.svg

# Test builds (2.0.0): BUILD = the package number (2.0.0-BUILD), always higher than the last one, so a new test
# build installs over the old one without "a later version is already installed"; CODE = a short code name of the
# task, added to the file names (qlim_2.0.0-2_amd64-manych.deb). Example: make ... T=gnu packages BUILD=2 CODE=manych
BUILD ?= 1
CODE  ?=
# nfpm.yaml with the paths filled in (nfpm does not expand variables in "src")
NFPM_SED := sed -e 's|$${VERSION}|$(VERSION)|g' -e 's|^release: .*|release: $(BUILD)|' -e 's|$${ROOT}|root|g' -e 's|$${PKGDIR}|$(CURDIR)/packaging|g' \
            $(if $(filter %32,$(T)),-e 's|^arch: .*|arch: 386|' -e 's|()(64bit)||') \
            $(if $(filter gnu32,$(T)),-e 's|libc6 (>= 2.34)|libc6 (>= 2.17)|' -e '/libgcc/d')
packages: tree
	$(NFPM_SED) packaging/nfpm-$(patsubst %32,%,$(T)).yaml > $(OUT)/nfpm.yaml
	rm -f $(OUT)/*.deb $(OUT)/*.rpm $(OUT)/*.apk
	cd $(OUT) && $(PKGROOT)/nfpm package -f nfpm.yaml -p $(if $(filter musl musl32,$(T)),apk,deb) -t .
	$(if $(filter musl musl32,$(T)),for f in $(OUT)/*.apk; do python3 packaging/apk-fix.py "$$f" || exit 1; done)   # 2.0.0: apk v3 (Alpine 3.23+)
	$(if $(filter gnu gnu32,$(T)),cd $(OUT) && $(PKGROOT)/nfpm package -f nfpm.yaml -p rpm -t .)
	$(if $(CODE),cd $(OUT) && for f in *.deb *.rpm *.apk; do [ -f "$$f" ] && mv "$$f" "$${f%.*}-$(CODE).$${f##*.}"; done; true)

# ---- AppImage (glibc build only): one file, runs on most distributions without installing ----
#   make -f packaging/Makefile.pkg T=gnu appimage   -> build-pkg/gnu/Q-LiM-<version>-x86_64.AppImage
# Tools (GitHub, see fetch-sources.sh): $(PKGROOT)/appimage/{appimagetool (extracted), runtime-x86_64}.
# libasound / libX11 / libgcc_s are NOT bundled (every desktop has them; a bundled ALSA would not find the system's
# ALSA plugins such as PipeWire's).
APPDIR   := $(OUT)/AppDir
AITOOL   := $(PKGROOT)/appimage/squashfs-root/AppRun
appimage: $(OUT)/qlim $(SEP_HELPER)
	rm -rf $(APPDIR) && mkdir -p $(APPDIR)/usr/bin/assets $(APPDIR)/usr/share/applications $(APPDIR)/usr/share/metainfo
	cp $(OUT)/qlim $(APPDIR)/usr/bin/qlim
	$(STRIP) --strip-debug $(APPDIR)/usr/bin/qlim
	$(if $(SEP_HELPER),cp $(SEP_HELPER) $(APPDIR)/usr/bin/ && $(STRIP) $(APPDIR)/usr/bin/qlim-separate)
	cp assets/DejaVuSans.ttf $(APPDIR)/usr/bin/assets/
	cp LICENSE $(APPDIR)/usr/bin/assets/LICENSE.txt
	cp packaging/AppRun $(APPDIR)/AppRun && chmod +x $(APPDIR)/AppRun
	cp packaging/qlim.desktop $(APPDIR)/qlim.desktop
	cp packaging/qlim.desktop $(APPDIR)/usr/share/applications/qlim.desktop
	cp assets/icons/qlim-256.png $(APPDIR)/qlim.png
	ln -sf qlim.png $(APPDIR)/.DirIcon
	for s in 16 32 48 64 128 256 512; do mkdir -p $(APPDIR)/usr/share/icons/hicolor/$${s}x$${s}/apps; \
	    cp assets/icons/qlim-$$s.png $(APPDIR)/usr/share/icons/hicolor/$${s}x$${s}/apps/qlim.png; done
	rm -f $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage
	ARCH=x86_64 VERSION=$(VERSION) $(AITOOL) --runtime-file $(PKGROOT)/appimage/runtime-x86_64 -n $(APPDIR) \
	    $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage
	@echo ">>> $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage"

clean:
	rm -rf build-pkg

-include $(OBJS:.o=.d)
.PHONY: all tree packages appimage clean
