# Q-LiM - Copyright (c) 2026 Georgi Stanimirov Ivanov. SPDX-License-Identifier: GPL-3.0-or-later (see LICENSE)
# ===== Linux packages: a self-contained qlim (libraries built in, see build-deps.sh) =====
#   make -f packaging/Makefile.pkg T=gnu      -> build-pkg/gnu/qlim   (+ .deb and .rpm with "make ... packages")
#   make -f packaging/Makefile.pkg T=musl     -> build-pkg/musl/qlim  (+ .apk)
# Only the system's libc, ALSA (libasound.so.2) and X11 (libX11.so.6) are needed at run time - the package
# manager installs them automatically if they are missing (they are on every desktop anyway).

T        ?= gnu
PKGROOT  ?= /opt/lnx
P        := $(PKGROOT)/$(T)/prefix
OUT      := build-pkg/$(T)
OBJD     := $(OUT)/obj
VERSION  := $(shell sed -n 's/^\#define QLIM_VERSION *"\(.*\)"/\1/p' src/version.h)

ifeq ($(T),musl)
TC       := $(PKGROOT)/x86_64-unknown-linux-musl/bin/x86_64-unknown-linux-musl
CC       := $(TC)-gcc
CXX      := $(TC)-g++
STRIP    := $(TC)-strip
XINC     := -I$(PKGROOT)/musl/xroot/usr/include
X11LIB   := $(PKGROOT)/musl/xroot/usr/lib/libX11.so
EXTRA_C  :=
else
CC       := gcc
CXX      := g++
STRIP    := strip
XINC     :=
X11LIB   := -lX11
EXTRA_C  := packaging/glibc_compat.c
endif

INC      := -Isrc -I$(P)/include -I$(P)/include/SDL2 -Ithird_party/rubberband \
            -Ithird_party/lv2 -Ithird_party/lilv -Ithird_party/clap/include -Ithird_party/vst3 $(XINC)
CFLAGS   := -std=c11 -O2 -g -Wall -Wno-unused-parameter -DHAVE_RUBBERBAND $(INC)
CXXFLAGS := -std=c++17 -O2 -g -Wall -Wno-unused-parameter $(INC)
PW_INC   := -isystem third_party/pipewire/pipewire-0.3 -isystem third_party/pipewire/spa-0.2
JACK_INC := -isystem $(PKGROOT)/src/jackinc          # 1.4.0: the JACK API headers (src/jack_shim.c)

SRC_C    := src/main.c src/audio.c src/session.c src/wav.c src/ui.c src/filebrowser.c src/project.c src/settings.c \
            src/theme.c src/stream.c src/diskinfo.c src/dsp_meter.c src/devwatch.c src/stream_sndfile.c \
            src/stream_resample.c src/mixer.c src/midiq.c src/smf.c src/peaks.c src/sdlgfx.c src/dropfiles.c src/undo.c src/ui_dialogs.c src/perf.c \
            src/bpm.c src/stretch.c src/applog.c src/audio_pw.c src/edit.c src/plugins.c src/plughost.c src/host_vst2.c \
            src/host_clap.c src/host_lv2.c src/fxchain.c src/plugwin.c src/jack_shim.c $(EXTRA_C)
SRC_CXX  := src/midi.cpp src/host_vst3.cpp
OBJS     := $(patsubst %.c,$(OBJD)/%.o,$(SRC_C)) $(patsubst %.cpp,$(OBJD)/%.o,$(SRC_CXX)) \
            $(OBJD)/rtmidi.o $(OBJD)/rubberband.o

# static: SDL2, SDL2_ttf (+FreeType, HarfBuzz), libsndfile (+codecs), PortAudio; dynamic: libasound, libX11, libc
STATIC   := $(P)/lib/libSDL2_ttf.a $(P)/lib/libharfbuzz.a $(P)/lib/libfreetype.a $(P)/lib/libSDL2.a $(P)/lib/libportaudio.a \
            $(P)/lib/libsndfile.a $(P)/lib/libFLAC.a $(P)/lib/libvorbisenc.a $(P)/lib/libvorbis.a $(P)/lib/libopus.a \
            $(P)/lib/libogg.a $(P)/lib/libmpg123.a $(P)/lib/libmp3lame.a
LIBS     := $(STATIC) -L$(P)/lib -lasound $(X11LIB) -lm -lpthread -ldl -lrt -static-libstdc++

all: $(OUT)/qlim

$(OUT)/qlim: $(OBJS)
	$(CXX) -rdynamic -Wl,--as-needed $(OBJS) -o $@ $(LIBS)
	@echo ">>> $@ built"

$(OBJD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(if $(findstring audio_pw,$<),$(PW_INC)) $(if $(findstring jack_shim,$<),$(JACK_INC)) -MMD -MP -c $< -o $@

$(OBJD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -I$(PKGROOT)/src/rtmidi -MMD -MP -c $< -o $@

$(OBJD)/rtmidi.o: $(PKGROOT)/src/rtmidi/RtMidi.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++17 -O2 -D__LINUX_ALSA__ -I$(P)/include -I$(PKGROOT)/src/rtmidi -c $< -o $@

$(OBJD)/rubberband.o: third_party/rubberband/single/RubberBandSingle.cpp
	@mkdir -p $(dir $@)
	$(CXX) -std=c++14 -O3 -ffast-math -U__FAST_MATH__ -w -c $< -o $@

# ---- package tree: /opt/qlim + menu entry, icons, file type ----
ROOT     := $(OUT)/root
tree: $(OUT)/qlim
	rm -rf $(ROOT)
	mkdir -p $(ROOT)/opt/qlim/assets $(ROOT)/usr/bin $(ROOT)/usr/share/applications $(ROOT)/usr/share/mime/packages \
	         $(ROOT)/usr/share/doc/qlim
	cp $(OUT)/qlim $(ROOT)/opt/qlim/qlim
	$(STRIP) --strip-debug $(ROOT)/opt/qlim/qlim
	cp assets/DejaVuSans.ttf $(ROOT)/opt/qlim/assets/
	cp LICENSE $(ROOT)/usr/share/doc/qlim/copyright
	ln -s /opt/qlim/qlim $(ROOT)/usr/bin/qlim
	cp packaging/qlim.desktop $(ROOT)/usr/share/applications/qlim.desktop
	cp packaging/qlim-project.xml $(ROOT)/usr/share/mime/packages/qlim-project.xml
	for s in 16 24 32 48 64 128 256 512; do \
	    mkdir -p $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/apps $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/mimetypes; \
	    cp assets/icons/qlim-$$s.png $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/apps/qlim.png; \
	    cp assets/icons/qlim-project-$$s.png $(ROOT)/usr/share/icons/hicolor/$${s}x$${s}/mimetypes/application-x-qlim-project.png; \
	done
	mkdir -p $(ROOT)/usr/share/icons/hicolor/scalable/apps && cp assets/icons/qlim.svg $(ROOT)/usr/share/icons/hicolor/scalable/apps/qlim.svg

# nfpm.yaml with the paths filled in (nfpm does not expand variables in "src")
NFPM_SED := sed -e 's|$${VERSION}|$(VERSION)|g' -e 's|$${ROOT}|root|g' -e 's|$${PKGDIR}|$(CURDIR)/packaging|g'
packages: tree
	$(NFPM_SED) packaging/nfpm-$(T).yaml > $(OUT)/nfpm.yaml
	rm -f $(OUT)/*.deb $(OUT)/*.rpm $(OUT)/*.apk
	cd $(OUT) && $(PKGROOT)/nfpm package -f nfpm.yaml -p $(if $(filter musl,$(T)),apk,deb) -t .
	$(if $(filter gnu,$(T)),cd $(OUT) && $(PKGROOT)/nfpm package -f nfpm.yaml -p rpm -t .)

# ---- AppImage (glibc build only): one file, runs on most distributions without installing ----
#   make -f packaging/Makefile.pkg T=gnu appimage   -> build-pkg/gnu/Q-LiM-<version>-x86_64.AppImage
# Tools (GitHub, see fetch-sources.sh): $(PKGROOT)/appimage/{appimagetool (extracted), runtime-x86_64}.
# libasound / libX11 / libgcc_s are NOT bundled (every desktop has them; a bundled ALSA would not find the system's
# ALSA plugins such as PipeWire's).
APPDIR   := $(OUT)/AppDir
AITOOL   := $(PKGROOT)/appimage/squashfs-root/AppRun
appimage: $(OUT)/qlim
	rm -rf $(APPDIR) && mkdir -p $(APPDIR)/usr/bin/assets $(APPDIR)/usr/share/applications $(APPDIR)/usr/share/metainfo
	cp $(OUT)/qlim $(APPDIR)/usr/bin/qlim
	$(STRIP) --strip-debug $(APPDIR)/usr/bin/qlim
	cp assets/DejaVuSans.ttf $(APPDIR)/usr/bin/assets/
	cp LICENSE $(APPDIR)/usr/bin/assets/LICENSE.txt
	cp packaging/AppRun $(APPDIR)/AppRun && chmod +x $(APPDIR)/AppRun
	cp packaging/qlim.desktop $(APPDIR)/qlim.desktop
	cp packaging/qlim.desktop $(APPDIR)/usr/share/applications/qlim.desktop
	cp assets/icons/qlim-256.png $(APPDIR)/qlim.png
	ln -sf qlim.png $(APPDIR)/.DirIcon
	for s in 16 32 48 64 128 256 512; do mkdir -p $(APPDIR)/usr/share/icons/hicolor/$${s}x$${s}/apps; \
	    cp assets/icons/qlim-$$s.png $(APPDIR)/usr/share/icons/hicolor/$${s}x$${s}/apps/qlim.png; done
	rm -f $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage
	ARCH=x86_64 VERSION=$(VERSION) $(AITOOL) --runtime-file $(PKGROOT)/appimage/runtime-x86_64 -n $(APPDIR) \
	    $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage
	@echo ">>> $(OUT)/Q-LiM-$(VERSION)-x86_64.AppImage"

clean:
	rm -rf build-pkg

-include $(OBJS:.o=.d)
.PHONY: all tree packages appimage clean
